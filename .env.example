# Meta Graph API version. Keep this configurable as Meta versions the Graph API.
META_GRAPH_API_VERSION=v25.0
META_REQUEST_TIMEOUT_MS=15000

# Optional model-generated reply drafts. Without a key, the local fallback remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REQUEST_TIMEOUT_MS=20000

# Governed auto-response. Default dry-run never sends. Allow phone numbers or BSUIDs.
AUTOMATION_MODE=dry-run
AUTOMATION_ALLOWLIST=
AUTOMATION_MIN_CONFIDENCE=0.9
AUTOMATION_INTERVAL_MS=5000
# Optional safe receipt acknowledgement when AI drafting is unavailable. Still allowlist-gated.
AUTOMATION_ACKNOWLEDGEMENT_ENABLED=false

# WhatsApp Cloud API credentials from Meta App Dashboard → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook values from the Meta app settings.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Protects operator-only APIs for sending messages and reading webhook events.
# Legacy single-admin token; keep for compatibility or replace with OPERATOR_ACCOUNTS_JSON.
OPERATOR_API_TOKEN=

# Optional local roles: viewer (read), agent (draft/reply/manage), admin (all + automation run).
# OPERATOR_ACCOUNTS_JSON=[{"id":"arvin","role":"admin","token":"replace-with-a-long-secret"}]
OPERATOR_ACCOUNTS_JSON=

# Local server options.
PORT=5179
HOST=127.0.0.1
PUBLIC_WEBHOOK_URL=
WORKSPACE_DB_PATH=.data/workspace.sqlite
WORKSPACE_BACKUP_DIR=.data/backups
WORKSPACE_RETENTION_DAYS=90
WORKSPACE_RETENTION_INTERVAL_MS=21600000
WORKSPACE_EVENT_LIMIT=500
WORKSPACE_AUDIT_LIMIT=1000

# Optional one-time migration source for event history created by older versions.
WHATSAPP_EVENT_STORE_PATH=.data/whatsapp-events.json
